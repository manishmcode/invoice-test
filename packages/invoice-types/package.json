{
  "name": "@hearth/invoice-types",
  "private": true,
  "version": "1.0.0",
  "main": "./dist/Index.js",
  "types": "./dist/Index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/Index.d.ts",
      "default": "./dist/Index.js"
    },
    "./modules/Invoice": {
      "types": "./dist/modules/Invoice/Index.d.ts",
      "default": "./dist/modules/Invoice/Index.js"
    }
  },
  "typesVersions": {
    "*": {
      "modules/Invoice": [
        "./dist/modules/Invoice/Index.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=11.19.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/modules/Invoice/CalculateInvoice.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
