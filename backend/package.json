{
  "name": "hearth-ledger-api",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=11.19.0"
  },
  "scripts": {
    "dev": "tsx watch --exclude ../node_modules --exclude node_modules src/Index.ts",
    "build": "tsc",
    "start": "node dist/Index.js",
    "typecheck": "tsc --noEmit",
    "test": "echo calculator coverage lives in @hearth/invoice-types",
    "migrate": "tsx ../node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "tsx ../node_modules/knex/bin/cli.js migrate:rollback --knexfile knexfile.ts",
    "seed": "tsx src/database/Seed.ts",
    "db:setup": "npm run migrate && npm run seed"
  },
  "dependencies": {
    "@hearth/invoice-types": "*",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "knex": "^3.3.0",
    "nodemailer": "^10.1.7",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
